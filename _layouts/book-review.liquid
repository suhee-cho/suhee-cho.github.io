---
layout: default
---
{% assign year = page.started | date: '%Y' %}
{% if year == "" %}{% assign year = page.finished | date: '%Y' %}{% endif %}
{% assign tags = page.tags | join: " " | split: " " %}

{% if page._styles %}
  <style type="text/css">{{ page._styles }}</style>
{% endif %}

<div class="post">
<div class="page-paper book-review-paper">

  <div class="book-review-layout">

    <!-- Left: metadata -->
    <div class="book-review-meta">

      <h1 class="book-review-title">{{ page.title }}</h1>

      <p class="book-review-author-line">
        {% if page.author %}{{ page.author }}{% endif %}
        {% if page.released %}
          {% if page.author %}&nbsp;&middot;&nbsp;{% endif %}
          {{ page.released }}
        {% endif %}
        {% if page.buy_link %}
          &nbsp;&middot;&nbsp;
          <a class="book-review-buy-link" target="_blank" href="{{ page.buy_link }}">
            <i class="fa-solid fa-cart-shopping"></i>
          </a>
        {% endif %}
      </p>

      {% assign has_tags = false %}
      {% for tag in tags %}{% if tag != "" %}{% assign has_tags = true %}{% endif %}{% endfor %}
      {% if has_tags %}
        <p class="book-review-tags">
          {% for tag in tags %}
            {% if tag != "" %}
              <a class="black-red-button" href="{{ tag | slugify | prepend: '/books/tag/' | relative_url }}">
                <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
              </a>
            {% endif %}
          {% endfor %}
        </p>
      {% endif %}

      {% if page.finished %}
        <p class="book-review-meta-item">Completed: {{ page.finished }}</p>
      {% endif %}

      {% if page.overall %}
        <p class="book-review-meta-item">
          Overall:&nbsp;
          {% assign full_stars = page.overall | floor %}
          {% assign half_star = page.overall | minus: full_stars %}
          {% assign empty_stars = 5 | minus: full_stars %}
          {% if half_star > 0 %}{% assign empty_stars = empty_stars | minus: 1 %}{% endif %}
          {% for i in (1..full_stars) -%}<i class="fa-solid fa-star fa-sm"></i>{%- endfor -%}
          {%- if half_star > 0 %}<i class="fa-solid fa-star-half-stroke fa-sm"></i>{% endif -%}
          {%- for i in (1..empty_stars) -%}<i class="fa-regular fa-star fa-sm"></i>{%- endfor %}
        </p>
      {% endif %}

      {% assign has_sub_ratings = false %}
      {% if page['relevance & interest'] or page['personal resonance'] or page['page-turner factor'] or page['writing style & tone'] or page['book hangover factor'] %}
        {% assign has_sub_ratings = true %}
      {% endif %}
      {% if has_sub_ratings %}
        <div class="book-review-sub-ratings">
          {% if page['relevance & interest'] %}
            <div class="book-review-sub-rating-row">
              <span class="book-review-sub-rating-label">Relevance &amp; interest</span>
              <span class="book-review-sub-rating-score">{{ page['relevance & interest'] | plus: 0.0 | round: 1 }}</span>
            </div>
          {% endif %}
          {% if page['personal resonance'] %}
            <div class="book-review-sub-rating-row">
              <span class="book-review-sub-rating-label">Personal resonance</span>
              <span class="book-review-sub-rating-score">{{ page['personal resonance'] | plus: 0.0 | round: 1 }}</span>
            </div>
          {% endif %}
          {% if page['page-turner factor'] %}
            <div class="book-review-sub-rating-row">
              <span class="book-review-sub-rating-label">Page-turner factor</span>
              <span class="book-review-sub-rating-score">{{ page['page-turner factor'] | plus: 0.0 | round: 1 }}</span>
            </div>
          {% endif %}
          {% if page['writing style & tone'] %}
            <div class="book-review-sub-rating-row">
              <span class="book-review-sub-rating-label">Writing style &amp; tone</span>
              <span class="book-review-sub-rating-score">{{ page['writing style & tone'] | plus: 0.0 | round: 1 }}</span>
            </div>
          {% endif %}
          {% if page['book hangover factor'] %}
            <div class="book-review-sub-rating-row">
              <span class="book-review-sub-rating-label">Book hangover factor</span>
              <span class="book-review-sub-rating-score">{{ page['book hangover factor'] | plus: 0.0 | round: 1 }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

    </div>

    <!-- Right: cover -->
    {% if page.cover or page.olid or page.isbn %}
      <div class="book-review-cover-col">
        {% if page.cover %}
          <img class="book-review-cover-img" alt="{{ page.title }} cover" src="{{ page.cover | relative_url }}">
        {% elsif page.olid %}
          <img class="book-review-cover-img" alt="{{ page.title }} cover" src="http://covers.openlibrary.org/b/olid/{{ page.olid }}-L.jpg?default=false">
        {% elsif page.isbn %}
          <img class="book-review-cover-img" alt="{{ page.title }} cover" src="http://covers.openlibrary.org/b/isbn/{{ page.isbn }}-L.jpg?default=false">
        {% endif %}
      </div>
    {% endif %}

  </div>

  {% if content != "" %}
    <hr class="book-review-divider">
    <article class="book-review-content">
      {{ content }}
    </article>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}

</div>
</div>
