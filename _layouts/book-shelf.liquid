---
layout: default
---
{% if page._styles %}
  <style type="text/css">{{ page._styles }}</style>
{% endif %}

{% assign collection = site[page.collection] %}

<div class="project">
  <header class="blog-hero">
    <h1 class="page-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="page-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if collection and collection.size > 0 %}
    {% assign all_tags_str = "" %}
    {% for item in collection %}
      {% if item.tags %}
        {% assign item_tags = item.tags | join: " " | split: " " %}
        {% for tag in item_tags %}
          {% if tag != "" %}
            {% assign all_tags_str = all_tags_str | append: tag | append: "|" %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
    {% assign tags_flat = all_tags_str | split: "|" | compact %}
    {% assign unique_tags = tags_flat | uniq %}

    {% assign tagged_counts = "" %}
    {% for tag in unique_tags %}
      {% assign cnt = 0 %}
      {% for t in tags_flat %}
        {% if t == tag %}{% assign cnt = cnt | plus: 1 %}{% endif %}
      {% endfor %}
      {% assign padded = "000" | append: cnt | slice: -3, 3 %}
      {% assign tagged_counts = tagged_counts | append: padded | append: "~~" | append: tag | append: "||" %}
    {% endfor %}
    {% assign sorted_tags = tagged_counts | split: "||" | sort | reverse %}

    {% if unique_tags.size > 0 %}
      <div class="tag-list">
        <p class="keywords-title" style="color: #fff;">Keywords</p>
        <ul class="keywords-list">
          {% for entry in sorted_tags limit:5 %}
            {% if entry != "" %}
              {% assign parts = entry | split: "~~" %}
              {% assign tag = parts[1] %}
              <li class="keywords-item">
                <a class="tag-label" data-tag="{{ tag | slugify }}" href="#" style="color: #fff;">
                  <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  {% endif %}

  <article>
    <div class="page-paper books-paper">

      {% if content != "" %}
        <div class="books-intro">{{ content }}</div>
      {% endif %}

      {% if collection and collection.size > 0 %}
        {% assign year = "" %}
        {% for item in collection reversed %}
          {% assign current_year = item.started | date: '%Y' %}
          {% if current_year != year %}
            {% unless forloop.first %}</div></div>{% endunless %}
            <div class="filter-group">
            <h2 class="books-year-heading">
              <a href="{{ current_year | prepend: '/books/' | relative_url }}">{{ current_year }}</a>
            </h2>
            <div class="books-row">
            {% assign year = current_year %}
          {% endif %}

          <figure class="cover filterable" data-tags="{{ item.tags | join: ' ' | split: ' ' | join: ' ' }}">
            <a class="cover-link" href="{{ item.url | relative_url }}">
              {% if item.cover %}
                <img alt="{{ item.title }} cover" src="{{ item.cover | relative_url }}" style="height:200px">
              {% elsif item.olid %}
                <img alt="{{ item.title }} cover" src="http://covers.openlibrary.org/b/olid/{{ item.olid }}-L.jpg?default=false" style="height:200px">
              {% elsif item.isbn %}
                <img alt="{{ item.title }} cover" src="http://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false" style="height:200px">
              {% endif %}
            </a>
          </figure>

          {% if forloop.last %}</div></div>{% endif %}
        {% endfor %}
      {% endif %}

    </div>
  </article>
</div>

<script>
(function () {
  var activeTag = null;

  function slugify(s) {
    return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-tag]');
    if (!btn) return;
    e.preventDefault();

    var tag = slugify(btn.dataset.tag);
    activeTag = (activeTag === tag) ? null : tag;

    document.querySelectorAll('[data-tag]').forEach(function (b) {
      b.classList.toggle('tag-active', slugify(b.dataset.tag) === activeTag);
    });

    document.querySelectorAll('.filterable').forEach(function (item) {
      if (!activeTag) {
        item.hidden = false;
      } else {
        var tags = (item.dataset.tags || '').split(/\s+/).filter(Boolean).map(slugify);
        item.hidden = !tags.includes(activeTag);
      }
    });

    document.querySelectorAll('.filter-group').forEach(function (group) {
      if (!activeTag) {
        group.hidden = false;
      } else {
        var visible = Array.from(group.querySelectorAll('.filterable')).some(function (c) { return !c.hidden; });
        group.hidden = !visible;
      }
    });
  });
})();
</script>
