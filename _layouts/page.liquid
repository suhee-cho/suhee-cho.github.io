---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="project">
  <header class="blog-hero">
    <h1 class="page-title">{{ page.title }}</h1>
    {% if page.description and page.description != "" %}
      <p class="page-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.display_tags and page.display_tags.size > 0 %}
    <div class="tag-list">
      <p class="keywords-title" style="color: #fff;">Keywords</p>
      <ul class="keywords-list">
        {% for tag in page.display_tags %}
          <li class="keywords-item">
            <a class="tag-label" style="color: #fff;" href="{{ tag | slugify | prepend: 'tag/' | prepend: page.rootlink | relative_url }}">
              <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
  
  <article>
    {{ content }}
  </article>
</div>
